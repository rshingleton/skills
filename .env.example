# Jira credentials for agent skills (triage, plan-it --jira, etc.)
#
# These are only used as a FALLBACK. If you've registered a Jira MCP connector
# (`claude mcp add --transport http jira https://your-jira-mcp-server/mcp`, see
# skills/engineering/to-jira/OPERATIONS.md), scripts/jira-connector-bridge.sh
# routes there instead and never touches these values.
#
# Copy ONE of:
#   mkdir -p ~/.config/ai-skills && cp .env.example ~/.config/ai-skills/.env
#   cp .env.example ~/.agents/.env
#   cp .env.example /path/to/your-app/.env
#
# Then edit the copy and set JIRA_API_TOKEN. Never commit a file containing the token.
#
# Load into your shell (env vars + all helper functions in one command):
#   source ~/.agents/skills/setup-internal-skills/scripts/load-jira-env.sh
# Or (direct export without helpers):
#   set -a && source ~/.config/ai-skills/.env && set +a

# Force which Jira path the bridge uses (scripts/jira-connector-bridge.sh):
#   true  -- always use the MCP connector, skip the auto-detect heuristic
#   false -- always use JIRA_API_TOKEN below, even inside Claude Code
# Leave unset to auto-detect (assumes the connector is available whenever
# running inside Claude Code, which is a heuristic, not a real check — set
# this explicitly if that guess is wrong for your setup).
# JIRA_MCP_CONNECTOR_AVAILABLE=true

JIRA_BASE_URL=https://jira.example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=your-project-key
# (If unset, inferred automatically from any known Jira key via _jira_ensure_project_key)

# Optional: default parent Epic for /plan-it --jira when --parent is omitted
# (overridden by docs/planning/<plan-id>/jira.md epic_key: when present)
# JIRA_DEFAULT_EPIC=MT-123

# Optional: Jira username for assignee on agent creates/updates (Doc Cycle + triage)
# JIRA_ASSIGNEE=yourusername

# Optional: default hours for new Jira Tasks when phase has no estimate_hours (POST timetracking as Nh)
# JIRA_DEFAULT_ESTIMATE_HOURS=4

# Optional: auth type for Jira API calls (bearer or basic). Default is bearer.
# Set to "basic" for Jira instances that require Basic auth (-u ":$JIRA_API_TOKEN").
# JIRA_AUTH_TYPE=basic

# Optional — watcher policy after writes (see jira-notifications.md):
# JIRA_WATCHER_IGNORE=dashboard          # DELETE: remove these users from watchers (comma-separated)
# JIRA_WATCHER_USERNAME=alice,bob        # POST: add these users as watchers after each create
# JIRA_EMAIL=dashboard@example.com          # If IGNORE unset: remove PAT owner (part before @)
