# Jira credentials for agent skills (triage, to-jiras, promote-to-jira, etc.)
#
# Copy ONE of:
#   mkdir -p ~/.config/ai-skills && cp .env.example ~/.config/ai-skills/.env
#   cp .env.example ~/.agents/.env
#   cp .env.example /path/to/your-app/.env
#
# Then edit the copy and set JIRA_API_TOKEN. Never commit a file containing the token.
#
# Load into your shell:
#   source ~/.local/share/ai-skills/scripts/load-jira-env.sh
# Or:
#   set -a && source ~/.config/ai-skills/.env && set +a

JIRA_BASE_URL=https://jira.example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=your-project-key

# Optional — NOT used for Bearer auth (PAT only). Used to derive the Jira username
# for DELETE .../watchers after creates/updates (doc-manager pattern). Set one of:
#   JIRA_WATCHER_USERNAME=dashboard
# or (username = part before @):
#   JIRA_EMAIL=dashboard@example.com
# If the PAT owner's Jira username is not the email prefix, use JIRA_WATCHER_USERNAME.
